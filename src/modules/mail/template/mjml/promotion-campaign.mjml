<mjml>
  <mj-head>
    <mj-title>{{campaignTitle}}</mj-title>
    <mj-preview>{{discountLabel}} dành riêng cho bạn từ {{appName}}.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Segoe UI', Arial, sans-serif" />
      <mj-text font-size="15px" color="#334155" line-height="1.7" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#fff7ed">
    <mj-section padding="36px 0 0">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" color="#7c2d12">{{appName}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#9a3412" border-radius="12px 12px 0 0" padding="36px 32px">
      <mj-column>
        <mj-text align="center" font-size="13px" font-weight="700" color="#fed7aa" text-transform="uppercase" letter-spacing="1px">Ưu đãi dành cho bạn</mj-text>
        <mj-text align="center" font-size="28px" font-weight="700" color="#ffffff">{{campaignTitle}}</mj-text>
        <mj-text align="center" font-size="18px" color="#ffedd5">{{discountLabel}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="32px 36px 12px">
      <mj-column>
        <mj-text>Xin chào <strong>{{customerName}}</strong>,</mj-text>
        <mj-text>{{promotionDescription}}</mj-text>
        <mj-text align="center" font-size="13px" color="#64748b" padding-bottom="6px">Nhập mã ưu đãi khi thanh toán</mj-text>
        <mj-text align="center" font-size="25px" font-weight="700" letter-spacing="3px" color="#9a3412" background-color="#fff7ed" padding="16px">
          {{promoCode}}
        </mj-text>
        <mj-text align="center" font-size="13px" color="#64748b">Ưu đãi kết thúc vào {{expiryDate}}.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 36px 24px">
      <mj-column>
        <mj-button href="{{promotionUrl}}" background-color="#ea580c" border-radius="7px" font-size="15px" font-weight="700">
          Khám phá ưu đãi
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff7ed" border-radius="0 0 12px 12px" padding="20px 36px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#7c2d12">
          Bạn nhận email này vì đã đăng ký nhận ưu đãi từ {{appName}}.<br />
          <a href="{{unsubscribeUrl}}" style="color:#9a3412;">Hủy đăng ký nhận email ưu đãi</a>
          &nbsp;·&nbsp;
          <a href="mailto:{{supportEmail}}" style="color:#9a3412;">Liên hệ hỗ trợ</a><br />
          © {{year}} {{appName}}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 36px"><mj-column /></mj-section>
  </mj-body>
</mjml>
