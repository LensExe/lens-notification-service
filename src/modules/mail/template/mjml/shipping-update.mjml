<mjml>
  <mj-head>
    <mj-title>Cập nhật giao hàng cho đơn {{orderNumber}}</mj-title>
    <mj-preview>Đơn hàng của bạn đang được vận chuyển.</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Segoe UI', Arial, sans-serif" />
      <mj-text font-size="15px" color="#334155" line-height="1.7" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f1f5f9">
    <mj-section padding="36px 0 0">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" color="#0f172a">{{appName}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="12px 12px 0 0" padding="32px 36px 12px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="700" color="#1d4ed8">Đơn hàng đang trên đường đến bạn</mj-text>
        <mj-text>Xin chào <strong>{{customerName}}</strong>,</mj-text>
        <mj-text>Đơn hàng <strong>{{orderNumber}}</strong> đã được bàn giao cho đơn vị vận chuyển.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="8px 36px 24px">
      <mj-column background-color="#eff6ff" border-radius="8px" padding="16px">
        <mj-text padding="4px 0"><strong>Trạng thái:</strong> {{shipmentStatus}}</mj-text>
        <mj-text padding="4px 0"><strong>Đơn vị vận chuyển:</strong> {{carrierName}}</mj-text>
        <mj-text padding="4px 0"><strong>Mã vận đơn:</strong> {{trackingNumber}}</mj-text>
        <mj-text padding="4px 0"><strong>Dự kiến giao:</strong> {{estimatedDeliveryDate}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 36px 24px">
      <mj-column>
        <mj-button href="{{trackingUrl}}" background-color="#1d4ed8" border-radius="7px" font-size="15px" font-weight="700">
          Theo dõi đơn hàng
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f8fafc" border-radius="0 0 12px 12px" padding="20px 36px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#64748b">
          Cần hỗ trợ? Liên hệ <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.<br />
          © {{year}} {{appName}}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 0 36px"><mj-column /></mj-section>
  </mj-body>
</mjml>
