<mjml>
  <mj-head>
    <mj-title>Chào mừng bạn đến với {{appName}}!</mj-title>
    <mj-preview>Tài khoản của bạn đã được tạo thành công trên {{appName}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Segoe UI', Arial, sans-serif" />
      <mj-text font-size="15px" color="#374151" line-height="1.7" />
    </mj-attributes>
    <mj-style>
      .feature-item {
        padding: 12px 16px;
        background-color: #f0fdf4;
        border-radius: 8px;
        margin-bottom: 8px;
      }
      .cta-button {
        display: inline-block;
        background: linear-gradient(135deg, #10b981, #059669);
        color: #ffffff;
        text-decoration: none;
        padding: 14px 40px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 0.3px;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f0fdf4">

    <!-- Top spacing -->
    <mj-section background-color="#f0fdf4" padding="40px 0 0">
      <mj-column>
        <mj-image width="1px" src="" />
      </mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section
      background-color="#10b981"
      border-radius="12px 12px 0 0"
      padding="48px 40px"
    >
      <mj-column>
        <mj-text align="center" font-size="48px" padding-bottom="16px" padding-top="0">
          🎉
        </mj-text>
        <mj-text
          align="center"
          font-size="26px"
          font-weight="700"
          color="#ffffff"
          padding-bottom="10px"
          padding-top="0"
        >
          Chào mừng bạn!
        </mj-text>
        <mj-text
          align="center"
          font-size="15px"
          color="rgba(255,255,255,0.9)"
          padding-top="0"
        >
          Tài khoản của bạn đã được tạo thành công
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Body -->
    <mj-section background-color="#ffffff" padding="40px 40px 16px">
      <mj-column>
        <mj-text font-size="16px" color="#374151" padding-bottom="16px">
          Xin chào <strong>{{userName}}</strong>,
        </mj-text>
        <mj-text font-size="15px" color="#6b7280" padding-top="0" padding-bottom="24px">
          Rất vui khi bạn tham gia <strong>{{appName}}</strong>! Tài khoản của bạn đã sẵn sàng.
          Hãy bắt đầu khám phá các tính năng ngay hôm nay.
        </mj-text>

        <!-- Feature: Email notifications -->
        <mj-section background-color="#f0fdf4" border-radius="8px" padding="12px 16px">
          <mj-column>
            <mj-text font-size="14px" color="#065f46" font-weight="600" padding="0">
              📧&nbsp;&nbsp;Thông báo qua Email
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-section padding="4px 0" />

        <!-- Feature: Real-time processing -->
        <mj-section background-color="#f0fdf4" border-radius="8px" padding="12px 16px">
          <mj-column>
            <mj-text font-size="14px" color="#065f46" font-weight="600" padding="0">
              ⚡&nbsp;&nbsp;Xử lý thời gian thực
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-section padding="4px 0" />

        <!-- Feature: Flexible notifications -->
        <mj-section background-color="#f0fdf4" border-radius="8px" padding="12px 16px">
          <mj-column>
            <mj-text font-size="14px" color="#065f46" font-weight="600" padding="0">
              🔔&nbsp;&nbsp;Quản lý thông báo linh hoạt
            </mj-text>
          </mj-column>
        </mj-section>
      </mj-column>
    </mj-section>

    <!-- CTA Button -->
    <mj-section background-color="#ffffff" padding="24px 40px 8px">
      <mj-column>
        <mj-button
          background-color="#10b981"
          color="#ffffff"
          font-size="16px"
          font-weight="600"
          letter-spacing="0.3px"
          border-radius="8px"
          padding="14px 40px"
          href="{{loginUrl}}"
        >
          Đăng nhập ngay →
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Support text -->
    <mj-section background-color="#ffffff" padding="8px 40px 32px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#9ca3af" padding="0">
          Cần hỗ trợ? Liên hệ chúng tôi tại
          <a href="mailto:{{supportEmail}}" style="color:#10b981;text-decoration:none;">{{supportEmail}}</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section
      background-color="#f9fafb"
      border-top="1px solid #e5e7eb"
      border-radius="0 0 12px 12px"
      padding="24px 40px"
    >
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af" padding="0">
          © {{year}} {{appName}}. Tất cả quyền được bảo lưu.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bottom spacing -->
    <mj-section background-color="#f0fdf4" padding="0 0 40px">
      <mj-column>
        <mj-image width="1px" src="" />
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

