    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.3.4",
    "mailgun.js": "^13.0.1",
    "mjml": "^5.1.0",
    "mongoose": "^9.6.1",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-redis": "^5.4.0",
    "typeorm": "^0.3.28"
