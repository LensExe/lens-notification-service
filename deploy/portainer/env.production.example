# Copy to deploy/portainer/env.production and replace every CHANGE_ME value.
# Keep the copied file out of Git because it contains production secrets.

NODE_ENV=production
PORT=3001
NOTIFICATION_IMAGE=ghcr.io/lensexe/lens-notification:latest
NOTIFICATION_PULL_POLICY=always

KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9094
KAFKA_CLIENT_ID=notification-service
KAFKA_USERNAME=kafka
KAFKA_PASSWORD=CHANGE_ME_KAFKA_PASSWORD
KAFKA_SSL=false
KAFKA_GROUP_ID=notification-service
KAFKA_FROM_BEGINNING=false
KAFKA_NOTIFICATION_EVENTS_TOPIC=notification.events
KAFKA_NOTIFICATION_EVENTS_DLQ_TOPIC=notification.events.dlq
KAFKA_MAIL_COMMANDS_TOPIC=notification.mail.commands.v1
KAFKA_MAIL_COMMANDS_DLQ_TOPIC=notification.mail.commands.v1.dlq
KAFKA_MAIL_COMMANDS_GROUP_ID=notification-mail
KAFKA_MAIL_COMMANDS_FROM_BEGINNING=false
KAFKA_CHAT_EVENTS_TOPIC=chat.conversation.events.v1
KAFKA_CHAT_EVENTS_DLQ_TOPIC=chat.conversation.events.v1.dlq
KAFKA_CHAT_EVENTS_GROUP_ID=notification-chat-realtime
KAFKA_CHAT_EVENTS_FROM_BEGINNING=false

MONGO_IMAGE=mongo:6
MONGO_PULL_POLICY=missing
MONGO_ROOT_USERNAME=noti_system_db_user
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGO_DB_NAME=noti_system_db
MONGO_URI=mongodb://noti_system_db_user:CHANGE_ME_MONGO_PASSWORD@notification-mongodb:27017/?authSource=admin

REDIS_HOST=lens-redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

KEYCLOAK_ISSUER=https://auth.lens.id.vn/realms/lens
KEYCLOAK_AUDIENCE=lens-be
KEYCLOAK_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_REAL_RSA_PUBLIC_KEY\n-----END PUBLIC KEY-----'

MAIL_PROVIDER_NAME=mailgun
MAILGUN_API_KEY=CHANGE_ME_MAILGUN_API_KEY
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=CHANGE_ME_MAILGUN_DOMAIN
MAILGUN_FROM_EMAIL=noreply@CHANGE_ME_MAILGUN_DOMAIN
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Notification Service

IMAGE_OWNER=lensexe
IMAGE_TAG=latest
